<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="木魚"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:fontFamily="serif" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_seg_track"
            android:padding="3dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tab_tap"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/bg_seg_selected"
                android:padding="0dp"
                android:text="敲擊"
                android:textColor="#141210"
                android:textSize="13sp" />
            <Button
                android:id="@+id/tab_sutra"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/bg_seg_idle"
                android:padding="0dp"
                android:text="經文"
                android:textColor="@color/gold"
                android:textSize="13sp" />
            <Button
                android:id="@+id/tab_look"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/bg_seg_idle"
                android:padding="0dp"
                android:text="外觀"
                android:textColor="@color/gold"
                android:textSize="13sp" />
            <Button
                android:id="@+id/tab_sound"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/bg_seg_idle"
                android:padding="0dp"
                android:text="音色"
                android:textColor="@color/gold"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tap_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="0"
                android:textColor="@color/text"
                android:textSize="56sp"
                android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum" />

            <TextView
                android:id="@+id/total_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日功德"
                android:textColor="@color/text3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/rounds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="累计 0 · 第 1 輪 · 本輪 0/108"
                android:textColor="@color/text2"
                android:textSize="13sp"
                android:fontFeatureSettings="tnum" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/sw_sound"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="敲擊音"
                    android:buttonTint="@color/gold"
                    android:textColor="@color/text" />

                <CheckBox
                    android:id="@+id/sw_vib"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="震動"
                    android:buttonTint="@color/gold"
                    android:textColor="@color/text" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/sw_recite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="誦讀　敲一下讀出當前字"
                android:buttonTint="@color/gold"
                android:textColor="@color/text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音色"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/voice_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/note_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="16dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:lineSpacingExtra="2dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="讀音依《金剛經誦讀筆記》校正：般若 bō rě、祇樹 qí shù、降伏 xiáng fú、願樂 yào…\n點此查看完整筆記 ›"
                android:textColor="@color/text3"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_dedicate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:minHeight="0dp"
                android:background="@drawable/bg_btn_primary_sel"
                android:text="回向"
                android:textColor="#141210"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="修習記錄"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <ListView
                android:id="@+id/hist_list"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp"
                android:divider="@color/line"
                android:dividerHeight="1dp"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/hist_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="敲擊滿 108 次或點「回向」後，記錄在此"
                android:textColor="@color/text3"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="關於"
                android:textColor="@color/text"
                android:textSize="15sp" />

            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="桌面敲木魚，功德記在心。"
                android:textColor="@color/text2"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="敲擊：小部件點一下即敲，木聲+震動"
                android:textColor="@color/text2"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="每滿 108 次響一聲磬，計一輪"
                android:textColor="@color/text2"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="今日功德零點歸零，累計永久保留"
                android:textColor="@color/text2"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="經文：三部可選，方框逐字讀"
                android:textColor="@color/text2"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="回向：清空今日，記入修習記錄"
                android:textColor="@color/text2"
                android:textSize="13sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="提示：若無反應，請允許「自啟動」"
                android:textColor="@color/text3"
                android:textSize="12sp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/line" />
            <LinearLayout
                android:id="@+id/link_weibo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="微博　@王药师"
                    android:textColor="@color/gold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text3"
                    android:textSize="18sp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />
            <LinearLayout
                android:id="@+id/link_twitter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="推特　@qq831261"
                    android:textColor="@color/gold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text3"
                    android:textSize="18sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textColor="@color/text3"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sutra_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="經文"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/sutra_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

            <RadioButton
                android:id="@+id/sutra_jj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="金剛經 · 鳩摩羅什譯"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            <RadioButton
                android:id="@+id/sutra_jg_xz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="金剛經 · 玄奘譯（能斷）"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            <RadioButton
                android:id="@+id/sutra_xj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="心經 · 玄奘譯"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/sw_sutra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="桌面顯示經文"
                android:buttonTint="@color/gold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="經文對比"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/contrast_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

            <RadioButton
                android:id="@+id/ct_same"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="同色"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            <RadioButton
                android:id="@+id/ct_read"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已讀亮"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            <RadioButton
                android:id="@+id/ct_unread"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未讀亮"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            </RadioGroup>

            <Button
                android:id="@+id/btn_reset_sutra"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="24dp"
                android:minHeight="0dp"
                android:background="@drawable/bg_btn_outline_sel"
                android:text="經文歸零（回到第一字）"
                android:textColor="@color/gold"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/look_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="預覽"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/preview_fish"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#0D0B09"
                    android:padding="26dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/fish_tight"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/mini3d_host"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#0D0B09" />

                <ImageView
                    android:id="@+id/preview_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter" />              
            
            </LinearLayout>

            <TextView
                android:id="@+id/preview_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="拖動旋轉 · 雙擊全屏 3D"
                android:textColor="@color/text3"
                android:textSize="11sp" />


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="預覽"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/style_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

            <RadioButton
                android:id="@+id/style_flat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="剪影"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            <RadioButton
                android:id="@+id/style_relief"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="微立體"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            <RadioButton
                android:id="@+id/style_jade"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="立體"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            </RadioGroup>

            <TextView
                android:id="@+id/mat_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="材質"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/mat_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/mat_jade"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="玉石"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:buttonTint="@color/gold" />

                <RadioButton
                    android:id="@+id/mat_wood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="木頭"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:buttonTint="@color/gold" />

                <RadioButton
                    android:id="@+id/mat_amber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="蜜蠟"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:buttonTint="@color/gold" />
            </RadioGroup>

            <TextView
                android:id="@+id/tone_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="色彩"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/tone_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/tone_paper"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="紙白"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:buttonTint="@color/gold" />

                <RadioButton
                    android:id="@+id/tone_ivory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="象牙白"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:buttonTint="@color/gold" />

                <RadioButton
                    android:id="@+id/tone_moon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="月白"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:buttonTint="@color/gold" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="數字"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/num_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

            <RadioButton
                android:id="@+id/num_off"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="不顯示"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            <RadioButton
                android:id="@+id/num_under"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="木魚下"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            <RadioButton
                android:id="@+id/num_corner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="經文右下"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/sw_num_hot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="敲擊時數字加亮"
                android:buttonTint="@color/gold"
                android:textColor="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="字色"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <RadioGroup
                android:id="@+id/ink_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

            <RadioButton
                android:id="@+id/ink_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="紙白（深壁紙）"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            <RadioButton
                android:id="@+id/ink_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="墨（淺壁紙）"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:buttonTint="@color/gold" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/sw_paper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="紙質底紋"
                android:buttonTint="@color/gold"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/scrim_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="底襯　0"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_scrim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="60"
                android:progress="0"
                android:progressTint="@color/gold"
                android:thumbTint="@color/gold" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/sound_page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="音色預設"
                android:textColor="@color/text"
                android:textSize="15sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:padding="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/preset_small"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/bg_chip_sel"
                    android:padding="0dp"
                    android:text="小木魚"
                    android:textColor="@color/gold"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/preset_big"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/bg_chip_sel"
                    android:padding="0dp"
                    android:text="大木魚"
                    android:textColor="@color/gold"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/preset_temple"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/bg_chip_sel"
                    android:padding="0dp"
                    android:text="寺廟共鳴"
                    android:textColor="@color/gold"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/preset_crisp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:background="@drawable/bg_chip_sel"
                    android:padding="0dp"
                    android:text="清脆"
                    android:textColor="@color/gold"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tonepitch_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="基頻　33"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_pitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="33"
                android:progressTint="@color/gold"
                android:thumbTint="@color/gold" />

            <TextView
                android:id="@+id/tonebright_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="脆度　55"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_bright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="55"
                android:progressTint="@color/gold"
                android:thumbTint="@color/gold" />

            <TextView
                android:id="@+id/tonedecay_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="餘韻　33"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/seek_decay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="33"
                android:progressTint="@color/gold"
                android:thumbTint="@color/gold" />


            <Button
                android:id="@+id/btn_tone_preview"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="20dp"
                android:minHeight="0dp"
                android:background="@drawable/bg_btn_outline_sel"
                android:text="試聽"
                android:textColor="@color/gold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
